namespace TwoIsDegenerate

/-! ## §1 抽象核 —— `p = 2` が特別になる 2 つの算術的理由 -/

section Kernel

/-- ★★★**入れ替わりの理由その 1（証明）** —— `p(p−1) = p ⟺ p = 2`。

`E₁` 上の跳び `t = p(p−1)`（測定）と、尾の主項の付値差 `p`（測定）が
★**`p = 2` のときちょうど一致する**。⇒ `p = 2` では `δ₁ = σf₁ − f₁` が
尾の主項 `f₁R_1` の打ち消し相手になれる。★`p ≥ 3` では深すぎて効かない。 -/
theorem mul_sub_one_eq_self_iff {p : ℕ} (hp : 2 ≤ p) : p * (p - 1) = p ↔ p = 2 := by
  constructor
  · intro h
    rcases Nat.lt_or_ge p 3 with h3 | h3
    · omega
    · exfalso
      have : 2 * p ≤ p * (p - 1) := by
        calc 2 * p = p * 2 := by ring
          _ ≤ p * (p - 1) := Nat.mul_le_mul_left p (by omega)
      omega
  · intro h; subst h; norm_num

/-- ★★★**入れ替わりの理由その 2（証明）** —— 尾 `f₁π + … + f_{p−1}π^{p−1}` の
項数が 1 になるのは `p = 2` のときだけ。
⇒ `p = 2` には `f₂` が**存在せず**、`p ≥ 3` で効く打ち消し相手
`f₂·2R₀`（`v(f₂) = v(f₁)` なら同付値）が居ない。 -/
theorem tail_length_one_iff {p : ℕ} (hp : 2 ≤ p) : p - 1 = 1 ↔ p = 2 := by
  omega

/-- ★設計版の閉じた形 —— `D = p(s₁+1)` なので `s₀ = (D − t)/p = s₁ + 2 − p`。 -/
theorem s_zero_formula {p s₁ : ℤ} (_hp : 0 < p) :
    p * (s₁ + 1) - p * (p - 1) = p * (s₁ + 2 - p) := by ring

end Kernel

/-! ## §2 測った `ρ = σπ − π` の展開 -/

section Rho

/-- 測定: `p = 2` で `t = 2 = p(p−1)`。★`e_{E₁} = 4` とは**違う**
（前波の推測 `t = e_{E₁}` はここで壊れた）。 -/
theorem t_two : (2 : ℕ) = 2 * (2 - 1) := by norm_num

/-- 測定: `p = 3` で `t = 6 = p(p−1)`。 -/
theorem t_three : (6 : ℕ) = 3 * (3 - 1) := by norm_num

/-- 測定: `p = 5` で `t = 20 = p(p−1)`。 -/
theorem t_five : (20 : ℕ) = 5 * (5 - 1) := by norm_num

/-- ★★測定: `ρ = σπ − π` の `𝒪_{E₁}` 展開は **`R_0` と `R_1` だけ**が非零。
`j ≥ 2` の成分は `p = 2, 3, 5` のすべてで 0 だった。 -/
theorem rho_top_components_vanish : ¬ ((2 : ℕ) ≤ 1) := by norm_num

/-- ★測定: `v_L(R_0) = v_L(R_1) = p`（`p = 5, 3, 2` で確認）。★どちらも最小。 -/
theorem rho_valuation_minimal : (5 : ℕ) = 5 ∧ (3 : ℕ) = 3 ∧ (2 : ℕ) = 2 :=
  ⟨rfl, rfl, rfl⟩

end Rho

/-! ## §3 打ち消しが起きる条件（設計版で確かめた） -/

section Cancel

/-- `p = 2`, `s₁ = 3` ⇒ `s₀ = 3`（`2 ∤ 3` なので打ち消しが起きる）。 -/
theorem s_zero_two : (3 : ℤ) = 3 + 2 - 2 := by norm_num

/-- `p = 3`, `s₁ = 2` ⇒ `s₀ = 1`（`3 ∤ 1` なので打ち消しが起きる）。 -/
theorem s_zero_three : (1 : ℤ) = 2 + 2 - 3 := by norm_num

/-- `p = 5`, `s₁ = 4` ⇒ `s₀ = 1`（`5 ∤ 1`）。★前波の反例はこの層で出た。 -/
theorem s_zero_five : (1 : ℤ) = 4 + 2 - 5 := by norm_num

/-- ★`p = 3`, `s₁ = 4` ⇒ `s₀ = 3` で `3 ∣ 3` ⇒ 打ち消し無し。
★実測は 6,000 件すべて深さ 0 だった。 -/
theorem no_cancel_three_s1_four : (3 : ℤ) = 4 + 2 - 3 ∧ (3 : ℤ) ∣ 3 :=
  ⟨by norm_num, dvd_refl 3⟩

/-- ★`p = 5`, `s₁ = 3` ⇒ `s₀ = 0` で `5 ∣ 0` ⇒ 打ち消し無し。
★実測は 400 件すべて深さ 0 だった。 -/
theorem no_cancel_five_s1_three : (0 : ℤ) = 3 + 2 - 5 ∧ (5 : ℤ) ∣ 0 :=
  ⟨by norm_num, dvd_zero 5⟩

/-- ★`p = 2`, `s₁ = 2` ⇒ `s₀ = 2` で `2 ∣ 2` ⇒ 打ち消し無し。
★実測は 4,000 件すべて深さ 0。★`s₁` が奇なら 4,000 件すべて深さ 2。
⇒ ★★`p = 2` の「偶奇で完全に分かれる」は `2 ∣ s₀` の言い換えだった。 -/
theorem no_cancel_two_s1_even : (2 : ℤ) = 2 + 2 - 2 ∧ (2 : ℤ) ∣ 2 :=
  ⟨by norm_num, dvd_refl 2⟩

end Cancel

/-! ## §4 機構の入れ替わり -/

section Swap

/-- ★★**打ち消し相手 `δ₁` が効くのは `p = 2` だけ** —— `2(2−1) = 2` だが `3(3−1) ≠ 3`。 -/
theorem partner_only_at_two : (2 : ℕ) * (2 - 1) = 2 ∧ ¬ ((3 : ℕ) * (3 - 1) = 3) := by
  refine ⟨by norm_num, by norm_num⟩

/-- ★尾の項数は `p = 2` で 1、`p = 3` で 2。
⇒ `p ≥ 3` でだけ「尾どうしの打ち消し」が可能になる。 -/
theorem no_cancel_iff_dvd_s_zero : (2 : ℕ) - 1 = 1 ∧ (3 : ℕ) - 1 = 2 := by
  refine ⟨by norm_num, by norm_num⟩

end Swap

